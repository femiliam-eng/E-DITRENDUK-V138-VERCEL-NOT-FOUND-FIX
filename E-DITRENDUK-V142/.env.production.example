# PRODUCTION ONLY: replace placeholders in hosting secret manager.
NODE_ENV=production
APP_ORIGIN=https://portal.example.go.id
DATABASE_URL=postgresql://app_user:REPLACE_PASSWORD@db.example.invalid:5432/editrenduk
NOTULEN_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SECRET_SERVER_ONLY
SUPABASE_STORAGE_BUCKET=notulen-private
AGENDA_STORAGE_BUCKET=agenda-private
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTES_MINIMUM
# OPTIONAL reverse proxy only. Set to exact socket IP(s) of the trusted reverse proxy.
# Proxy MUST overwrite (not append/client-preserve) X-Real-IP at its ingress.
# If unset, login limits use TCP peer IP; on some managed hosts all users may share one proxy IP.
# TRUSTED_PROXY_IPS=10.0.0.10,10.0.0.11
